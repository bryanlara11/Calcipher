# Copy to backend/.env and adjust. Every value has a safe default in app/config.py.

DATABASE_URL=postgresql+psycopg://calcipher:calcipher@localhost:5432/calcipher

# Server-only key restricted to Places API (New)
GOOGLE_PLACES_API_KEY=

# --- Embeddings ---
# sentence-transformers (RoBERTa, 768-dim) or hash (deterministic, offline, tests only).
# Changing either value requires: python -m app.ingest reembed   (GET /api/v1/health shows stale_embeddings)
EMBEDDER_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-distilroberta-v1

# --- Demo data (python -m app.db.seed; docker runs it on every boot) ---
# Set SEED_DEMO_ITEMS=false once real data is loaded, then: python -m app.db.seed --purge-demo-items
SEED_DEMO_ITEMS=true
SEED_DEMO_BRANCHES=false

# --- OCR ingestion (python -m app.ingest) ---
# Leave empty to auto-detect from PATH or C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# e.g. eng+fil after installing the Filipino traineddata
OCR_LANG=eng

# --- Google Gemini (optional; regex parser + template answers are used without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- API ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
