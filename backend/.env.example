# Copy to backend/.env and adjust. Every value has a safe default in app/config.py.

DATABASE_URL=postgresql+psycopg://calcipher:calcipher@localhost:5432/calcipher

# --- OpenStreetMap Overpass (free, no key) ---
OVERPASS_ENABLED=true
OVERPASS_URLS=["https://overpass-api.de/api/interpreter","https://overpass.kumi.systems/api/interpreter"]
OVERPASS_USER_AGENT=CalCipher-UPM-Academic-Project/1.0
OVERPASS_TIMEOUT_S=20
OVERPASS_CACHE_TTL_HOURS=24
OVERPASS_MAX_RADIUS_M=5000
# After a failed fetch, serve cached branches without retrying Overpass for this long.
OVERPASS_FAILURE_COOLDOWN_S=300

# --- Embeddings ---
# sentence-transformers (RoBERTa, 768-dim) or hash (deterministic, offline, tests only).
# Changing either value requires: python -m app.db.seed --reembed
EMBEDDER_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-distilroberta-v1

# --- Google Gemini (optional; regex parser + template answers are used without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- API ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
